# AutoScript backend environment template.
# Copy to a local .env (gitignored) or export these before `mvnw spring-boot:run`.
# NEVER commit real keys.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── AI script-reviewer (OpenRouter — OpenAI-compatible) ──────────────────────
# Turn the AI extraction/review feature on.
AUTOSCRIPT_AI_ENABLED=true
# OpenRouter OpenAI-compatible endpoint.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Your OpenRouter API key (sk-or-...). Keep this out of git.
LLM_API_KEY=
# Chat + vision model. Gemini 2.5 Flash via OpenRouter handles text and images.
LLM_MODEL=google/gemini-2.5-flash
# Optional attribution header OpenRouter shows in its dashboard.
LLM_REFERER=http://localhost:8080
