# ---------- Database (Docker Compose exposes pgvector Postgres on 5433) ----------
DATABASE_URL=postgresql://autoscript:autoscript@localhost:5433/autoscript
TEST_DATABASE_URL=postgresql://autoscript:autoscript@localhost:5433/autoscript_test

# ---------- Service ports / URLs ----------
API_PORT=8080
RX_ENGINE_PORT=4210
API_URL=http://localhost:8080
RX_ENGINE_URL=http://localhost:4210
UPLOAD_DIR=./uploads

# ---------- LLM (OpenAI-compatible; OpenRouter recommended) ----------
# Required for extraction + AI reasoning. Without it, prescriptions fail with an explicit error.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Text + JSON model used for extraction from text/PDF and for the analysis narrative
LLM_MODEL=google/gemini-2.5-flash
# Multimodal model used to read JPG/PNG prescriptions (defaults to LLM_MODEL if unset)
LLM_VISION_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT_MS=90000

# ---------- Embeddings for RAG (optional) ----------
# If unset or the provider rejects the request, retrieval falls back to Postgres
# full-text search and the report says so. Vectors are 1536-dim.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# ---------- Demo reliability timeouts ----------
# Engine: hard per-analysis deadline; a hung provider call becomes a Failed prescription with a reason.
ANALYSIS_TIMEOUT_MS=150000
# API: a prescription still PROCESSING with no engine update for this long is marked Failed (keep above ANALYSIS_TIMEOUT_MS).
PROCESSING_TIMEOUT_MS=180000
STALE_SWEEP_INTERVAL_MS=60000
